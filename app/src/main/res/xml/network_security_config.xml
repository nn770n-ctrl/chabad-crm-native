<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS בלבד, ותעודות מערכת בלבד (ללא תעודות שהמשתמש התקין). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
